{
  "name": "marcogrimaldi29-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal hub of Marco Grimaldi — Astro rearchitecture of marcogrimaldi29.com",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "favicons": "node scripts/generate-favicons.mjs",
    "search:index": "npm run build && node scripts/copy-pagefind.mjs",
    "check": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "lint:md": "markdownlint-cli2 \"src/content/**/*.{md,mdx}\"",
    "lint:spell": "cspell \"**/*.{md,mdx,astro,ts,css}\"",
    "verify": "npm run check && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.2",
    "simple-icons": "^16.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@typescript-eslint/parser": "^8.29.1",
    "cspell": "^8.18.1",
    "eslint": "^9.24.0",
    "eslint-plugin-astro": "^1.3.1",
    "markdownlint-cli2": "^0.23.2",
    "pagefind": "^1.3.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "stylelint": "^16.18.0",
    "stylelint-config-standard": "^38.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.29.1"
  }
}

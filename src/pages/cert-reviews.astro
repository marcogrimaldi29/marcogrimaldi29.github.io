---
/** /cert-reviews/ — data-driven landing with docs rails (side-nav + TOC). */
import PageLayout from '@layouts/PageLayout.astro';
import GroupTabs from '@components/GroupTabs.astro';
import QuickLink from '@components/QuickLink.astro';
import SupportNote from '@components/SupportNote.astro';
import {
  certReviewsGoogle,
  certReviewsMicrosoft,
  groupCards,
  professionalCertGroups,
  toGroupNav,
} from '@data/landings';

const msGroups = groupCards(certReviewsMicrosoft);
const googleGroups = professionalCertGroups(certReviewsGoogle);
const navGroups = [
  { title: 'Microsoft', items: toGroupNav(msGroups) },
  { title: 'Google', items: toGroupNav(googleGroups) },
];
const headings = [
  { depth: 2, slug: 'microsoft', text: 'microsoft' },
  { depth: 2, slug: 'google', text: 'google' },
];
---

<PageLayout
  title="Cert Reviews"
  heading="🏅 Cert Reviews"
  eyebrow="// certification reviews & exam experiences"
  lead="First-hand reviews of the certifications I’ve earned — prep strategies, study resources, and exam experience."
  description="First-hand reviews of the certifications I’ve earned — prep strategies, study resources, and exam experience."
  searchable
  navGroups={navGroups}
  headings={headings}
>
  <SupportNote kind="reviews" />

  <h2 class="section-heading" id="microsoft">
    microsoft
  </h2>
  <GroupTabs name="microsoft" groups={msGroups} />

  <h2 class="section-heading" id="google">
    google
  </h2>
  <GroupTabs name="google" groups={googleGroups} />

  <hr class="see-also-rule" />
  <p class="eyebrow">{'// see also'}</p>
  <div class="card-grid">
    <QuickLink
      icon="📘"
      title="Study Notes"
      subtitle="Structured prep material"
      href="/study-notes/"
    />
    <QuickLink icon="🧰" title="Resources" subtitle="Curated collections" href="/resources/" />
  </div>
</PageLayout>

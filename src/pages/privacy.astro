---
/** /privacy/ — restyled to match About: hero + `#` sections + brand/TOC rails. */
import PageLayout from '@layouts/PageLayout.astro';

const headings = [
  { depth: 2, slug: 'who-operates', text: 'who operates this site' },
  { depth: 2, slug: 'data-collected', text: 'what data is collected' },
  { depth: 2, slug: 'cookies', text: 'cookies' },
  { depth: 2, slug: 'your-rights', text: 'your rights' },
  { depth: 2, slug: 'contact', text: 'contact' },
];
---

<PageLayout
  title="Privacy Notice"
  heading="🍪 Privacy Notice"
  eyebrow="// gdpr-compliant · cookieless"
  lead="What information is — and isn’t — collected when you visit this website. No cookies, no tracking profiles — just anonymous insights to improve your experience."
  description="What information is — and isn’t — collected when you visit this website. No cookies, no tracking profiles — just anonymous insights to improve your experience."
  headings={headings}
  brandRail
>
  <div class="legal">
    <h2 class="section-heading" id="who-operates">who operates this site</h2>
    <p>
      This website is a personal project maintained by <strong>Marco Grimaldi</strong>, hosted on <a
        href="https://pages.github.com"
        rel="noopener"
        target="_blank">GitHub Pages</a
      > and built with <a href="https://www.astro.build/" rel="noopener" target="_blank">Astro</a>.
    </p>

    <h2 class="section-heading" id="data-collected">what data is collected</h2>
    <p><strong>📊 Visit analytics (Umami)</strong></p>
    <p>
      This site uses <a href="https://umami.is" rel="noopener" target="_blank">Umami Analytics</a>,
      a privacy-friendly, open-source analytics platform. It does <strong>not use cookies</strong> and
      does <strong>not collect personal data</strong>. Anonymous statistics (such as page views and
      referrers) are processed only to improve site content and usability.
    </p>
    <p><strong>🖥️ Hosting and logs</strong></p>
    <p>
      The site is hosted by <strong>GitHub Pages</strong> (GitHub, Inc.), which may collect limited technical
      data — such as IP addresses and request metadata — for operational and security purposes. For details,
      see <a
        href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement"
        rel="noopener"
        target="_blank">GitHub’s Privacy Statement</a
      >.
    </p>

    <h2 class="section-heading" id="cookies">cookies</h2>
    <p>
      This website <strong>does not use any cookies</strong> for analytics, advertising, or tracking.
      GitHub Pages itself may use cookies strictly necessary for site delivery and performance.
    </p>

    <h2 class="section-heading" id="your-rights">your rights</h2>
    <p>
      Depending on your jurisdiction (for example, under the EU General Data Protection Regulation — <a
        href="https://gdpr.eu/what-is-gdpr/"
        rel="noopener"
        target="_blank">GDPR</a
      >), you may have the right to:
    </p>
    <ul>
      <li>
        Request access to, correction of, or deletion of personal data (if any were ever collected);
      </li>
      <li>Object to or restrict data processing;</li>
      <li>Lodge a complaint with a data protection authority.</li>
    </ul>
    <p>
      As this site does not actively collect personal data, these rights generally do not apply
      here. Still, you can <a href="/contact/">contact the owner</a> at any time for clarifications.
    </p>

    <h2 class="section-heading" id="contact">contact</h2>
    <p>
      For questions or concerns about this Privacy Notice, feel free to <a href="/contact/">
        reach out to me</a
      >.
    </p>

    <p class="notice notice--success">
      <em>
        This website respects your privacy. No cookies. No tracking profiles. Just insights to
        improve your browsing experience.
      </em>
    </p>
  </div>
</PageLayout>

<style>
  .legal p {
    max-width: 48rem;
  }

  .legal ul {
    max-width: 48rem;
    padding-left: 1.4rem;
  }

  .legal li {
    margin-bottom: var(--sp-2);
    line-height: 1.6;
  }

  .legal li::marker {
    color: var(--brand);
  }
</style>

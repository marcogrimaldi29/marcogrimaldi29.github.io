---
/** /it/search/ — ricerca nel sito (Pagefind). */
import PageLayout from '@layouts/PageLayout.astro';
import Search from '@components/Search.astro';
import { getLocaleFromUrl, useTranslations } from '@i18n/utils';

const t = useTranslations(getLocaleFromUrl(Astro.url));
---

<PageLayout
  title="Cerca"
  heading="🔎 Cerca"
  eyebrow="// ricerca nel sito"
  lead="Trova appunti di studio, recensioni di certificazioni e risorse in tutto il sito."
  description="Trova appunti di studio, recensioni di certificazioni e risorse in tutto il sito."
  noindex
>
  <Search />
  <noscript>
    <p class="notice notice--info">{t('search.noscript')}</p>
  </noscript>
</PageLayout>

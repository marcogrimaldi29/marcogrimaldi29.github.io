---
/** /de/study-notes/ — Landing DE (Lernnotizen). Article links point to EN articles. */
import PageLayout from '@layouts/PageLayout.astro';
import GroupTabs from '@components/GroupTabs.astro';
import QuickLink from '@components/QuickLink.astro';
import SupportNote from '@components/SupportNote.astro';
import { studyNotesDe, deepDivesDe } from '@data/landings-de';
import { groupCards, toGroupNav } from '@data/landings';

const noteGroups = groupCards(studyNotesDe, 'de');
const diveGroups = groupCards(deepDivesDe, 'de');
const navGroups = [
  { title: 'Lernnotizen', items: toGroupNav(noteGroups, / Lernnotizen$/) },
  { title: 'Deep Dives', items: toGroupNav(diveGroups) },
];
const headings = [
  { depth: 2, slug: 'lernnotizen', text: 'lernnotizen' },
  { depth: 2, slug: 'deep-dives', text: 'deep dives' },
];
---

<PageLayout
  title="Notizen"
  heading="📘 Notizen"
  eyebrow="// notizen zu zertifizierungen"
  lead="Strukturierte Notizen für IT-Prüfungen: Microsoft, ITIL und mehr — plus Deep Dives zu speziellen Themen der Cloud-Architektur."
  description="Strukturierte Notizen für IT-Prüfungen: Microsoft, ITIL und mehr — plus Deep Dives zu speziellen Themen der Cloud-Architektur."
  searchable
  navGroups={navGroups}
  headings={headings}
>
  <SupportNote />

  <h2 class="section-heading" id="lernnotizen">
    lernnotizen
  </h2>
  <GroupTabs name="notes" groups={noteGroups} />

  <h2 class="section-heading" id="deep-dives">
    deep dives
  </h2>
  <GroupTabs name="dives" groups={diveGroups} />

  <hr class="see-also-rule" />
  <p class="eyebrow">{'// siehe auch'}</p>
  <div class="card-grid">
    <QuickLink
      icon="🏅"
      title="Reviews"
      subtitle="Prüfungserfahrungen & Tipps"
      href="/de/cert-reviews/"
    />
    <QuickLink
      icon="🧰"
      title="Ressourcen"
      subtitle="Kuratierte Sammlungen"
      href="/de/resources/"
    />
  </div>
</PageLayout>

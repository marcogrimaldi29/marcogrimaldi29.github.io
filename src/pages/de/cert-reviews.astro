---
/** /de/cert-reviews/ — Landing DE (Reviews). */
import PageLayout from '@layouts/PageLayout.astro';
import GroupTabs from '@components/GroupTabs.astro';
import QuickLink from '@components/QuickLink.astro';
import SupportNote from '@components/SupportNote.astro';
import { certReviewsGoogleDe, certReviewsMicrosoftDe } from '@data/landings-de';
import { groupCards, professionalCertGroups, toGroupNav } from '@data/landings';

const msGroups = groupCards(certReviewsMicrosoftDe, 'de');
const googleGroups = professionalCertGroups(certReviewsGoogleDe);
const navGroups = [
  { title: 'Microsoft', items: toGroupNav(msGroups) },
  { title: 'Google', items: toGroupNav(googleGroups) },
];
const headings = [
  { depth: 2, slug: 'microsoft', text: 'microsoft' },
  { depth: 2, slug: 'google', text: 'google' },
];
---

<PageLayout
  title="Reviews"
  heading="🏅 Reviews"
  eyebrow="// reviews & prüfungserfahrungen"
  lead="Reviews aus erster Hand zu den Zertifizierungen, die ich erworben habe — Vorbereitungsstrategien, Lernressourcen und Prüfungserfahrung."
  description="Reviews aus erster Hand zu den Zertifizierungen, die ich erworben habe — Vorbereitungsstrategien, Lernressourcen und Prüfungserfahrung."
  searchable
  navGroups={navGroups}
  headings={headings}
>
  <SupportNote kind="reviews" />

  <h2 class="section-heading" id="microsoft">
    microsoft
  </h2>
  <GroupTabs name="microsoft" groups={msGroups} />

  <h2 class="section-heading" id="google">
    google
  </h2>
  <GroupTabs name="google" groups={googleGroups} />

  <hr class="see-also-rule" />
  <p class="eyebrow">{'// siehe auch'}</p>
  <div class="card-grid">
    <QuickLink icon="📘" title="Notizen" subtitle="Vorbereitungsmaterial" href="/de/study-notes/" />
    <QuickLink
      icon="🧰"
      title="Ressourcen"
      subtitle="Kuratierte Sammlungen"
      href="/de/resources/"
    />
  </div>
</PageLayout>

---
/** /de/privacy/ — Datenschutzerklärung. */
import PageLayout from '@layouts/PageLayout.astro';

const headings = [
  { depth: 2, slug: 'wer-betreibt', text: 'wer die website betreibt' },
  { depth: 2, slug: 'erhobene-daten', text: 'welche daten erhoben werden' },
  { depth: 2, slug: 'cookies', text: 'cookies' },
  { depth: 2, slug: 'deine-rechte', text: 'deine rechte' },
  { depth: 2, slug: 'kontakt', text: 'kontakt' },
];
---

<PageLayout
  title="Datenschutzerklärung"
  heading="🍪 Datenschutzerklärung"
  eyebrow="// dsgvo-konform · ohne cookies"
  lead="Welche Informationen beim Besuch dieser Website erhoben werden — und welche nicht. Keine Cookies, keine Tracking-Profile — nur anonyme Statistiken, um dein Erlebnis zu verbessern."
  description="Welche Informationen beim Besuch dieser Website erhoben werden — und welche nicht. Keine Cookies, keine Tracking-Profile — nur anonyme Statistiken, um dein Erlebnis zu verbessern."
  headings={headings}
  brandRail
>
  <div class="legal">
    <h2 class="section-heading" id="wer-betreibt">wer die website betreibt</h2>
    <p>
      Diese Website ist ein persönliches Projekt von <strong>Marco Grimaldi</strong>, gehostet auf <a
        href="https://pages.github.com"
        rel="noopener"
        target="_blank">GitHub Pages</a
      > und erstellt mit <a href="https://www.astro.build/" rel="noopener" target="_blank">Astro</a
      >.
    </p>

    <h2 class="section-heading" id="erhobene-daten">welche daten erhoben werden</h2>
    <p><strong>📊 Besuchsanalyse (Umami)</strong></p>
    <p>
      Diese Website verwendet <a href="https://umami.is" rel="noopener" target="_blank"
        >Umami Analytics</a
      >, eine datenschutzfreundliche Open-Source-Analyseplattform. Sie verwendet keine <strong
        >Cookies</strong
      > und erhebt keine <strong>personenbezogenen Daten</strong>. Es werden nur anonyme Statistiken
      (wie Seitenaufrufe und Referrer) verarbeitet, um Inhalte und Usability der Website zu
      verbessern.
    </p>
    <p><strong>🖥️ Hosting und Protokolle</strong></p>
    <p>
      Die Website wird von <strong>GitHub Pages</strong> (GitHub, Inc.) gehostet, das begrenzte technische
      Daten — wie IP-Adressen und Anfrage-Metadaten — zu Betriebs- und Sicherheitszwecken erheben kann.
      Weitere Einzelheiten findest du in der <a
        href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement"
        rel="noopener"
        target="_blank">Datenschutzerklärung von GitHub</a
      >.
    </p>

    <h2 class="section-heading" id="cookies">cookies</h2>
    <p>
      Diese Website <strong>verwendet keinerlei Cookies</strong> für Analyse, Werbung oder Tracking. GitHub
      Pages kann unbedingt erforderliche Cookies für die Auslieferung und Leistung der Website verwenden.
    </p>

    <h2 class="section-heading" id="deine-rechte">deine rechte</h2>
    <p>
      Je nach deiner Rechtsprechung (zum Beispiel gemäß der Datenschutz-Grundverordnung der EU — <a
        href="https://gdpr.eu/what-is-gdpr/"
        rel="noopener"
        target="_blank">DSGVO</a
      >) hast du möglicherweise das Recht:
    </p>
    <ul>
      <li>
        Zugang, Berichtigung oder Löschung personenbezogener Daten zu verlangen (sofern jemals
        erhoben);
      </li>
      <li>Der Verarbeitung von Daten zu widersprechen oder sie einzuschränken;</li>
      <li>Eine Beschwerde bei einer Aufsichtsbehörde einzureichen.</li>
    </ul>
    <p>
      Da diese Website nicht aktiv personenbezogene Daten erhebt, sind diese Rechte in der Regel
      nicht anwendbar. Du kannst dich dennoch jederzeit an den <a href="/de/contact/"
        >Verantwortlichen wenden</a
      >, um etwas zu klären.
    </p>

    <h2 class="section-heading" id="kontakt">kontakt</h2>
    <p>
      Bei Fragen oder Bedenken zu dieser Datenschutzerklärung zögere nicht, mich zu <a
        href="/de/contact/">kontaktieren</a
      >.
    </p>

    <p class="notice notice--success">
      <em>
        Diese Website respektiert deine Privatsphäre. Keine Cookies. Keine Tracking-Profile. Nur
        Statistiken, um dein Surferlebnis zu verbessern.</em
      >
    </p>
  </div>
</PageLayout>

<style>
  .legal p {
    max-width: 48rem;
  }

  .legal ul {
    max-width: 48rem;
    padding-left: 1.4rem;
  }

  .legal li {
    margin-bottom: var(--sp-2);
    line-height: 1.6;
  }

  .legal li::marker {
    color: var(--brand);
  }
</style>

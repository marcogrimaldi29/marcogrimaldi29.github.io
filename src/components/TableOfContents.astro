---
/**
 * TableOfContents — the right-rail "On this page" nav (Astro/GitHub-docs
 * style). Takes a headings array ({ depth, slug, text }) and highlights the
 * section currently in view via a scroll-spy script. Renders nothing when
 * there are fewer than 2 headings.
 */
import { getLocaleFromUrl, useTranslations } from '@i18n/utils';

export interface TocHeading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  headings: TocHeading[];
  /**
   * `rail` (default) — the sticky right-hand rail with scroll-spy.
   * `inline` — a collapsible disclosure placed at the top of the content,
   * shown only when the rail is hidden on narrow viewports.
   */
  variant?: 'rail' | 'inline';
}
const { headings, variant = 'rail' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = items.length >= 2;
const t = useTranslations(getLocaleFromUrl(Astro.url));
const label = t('toc.onThisPage');
---

{
  show && variant === 'rail' && (
    <nav class="toc doc__rail doc__toc" aria-label={label}>
      <p class="toc__title">{label}</p>
      <ul class="toc__list">
        {items.map((h) => (
          <li class:list={['toc__item', `toc__item--d${h.depth}`]}>
            <a href={`#${h.slug}`} data-toc={h.slug}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  show && variant === 'inline' && (
    <details class="toc-inline">
      <summary class="toc-inline__summary">{label}</summary>
      <ul class="toc-inline__list">
        {items.map((h) => (
          <li class:list={['toc-inline__item', `toc-inline__item--d${h.depth}`]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style>
  .toc__title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: lowercase;
    letter-spacing: 0.03em;
    color: var(--text-subtle);
    margin: 0 0 var(--sp-3);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--border);
  }

  .toc__item a {
    display: block;
    padding: 4px 0 4px var(--sp-3);
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--text-muted);
    line-height: 1.4;
    text-decoration: none;
    /* Match the lowercased headings in the main content. */
    text-transform: lowercase;
  }

  .toc__item--d3 a {
    padding-left: var(--sp-5);
    font-size: 0.78rem;
  }

  .toc__item a:hover {
    color: var(--text);
  }

  .toc__item a.is-active {
    color: var(--brand-strong);
    border-left-color: var(--brand);
  }

  /* ---- inline variant: an in-page quick view shown only when the rail is
     hidden (the right TOC collapses at <= 1080px). ---- */
  .toc-inline {
    display: none;
    margin: 0 0 var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  @media (width <= 1080px) {
    .toc-inline {
      display: block;
    }
  }

  .toc-inline__summary {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-3) var(--sp-4);
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: lowercase;
    letter-spacing: 0.03em;
    color: var(--text-subtle);
    list-style: none;
  }

  /* hide the native disclosure marker (both engines) */
  .toc-inline__summary::-webkit-details-marker {
    display: none;
  }

  /* chevron that flips when open */
  .toc-inline__summary::after {
    content: '';
    margin-left: auto;
    width: 0.5em;
    height: 0.5em;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--transition);
  }

  .toc-inline[open] .toc-inline__summary::after {
    transform: rotate(-135deg);
  }

  .toc-inline__summary:hover {
    color: var(--text-muted);
  }

  .toc-inline__summary:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
    border-radius: var(--radius);
  }

  .toc-inline__list {
    list-style: none;
    margin: 0;
    padding: 0 var(--sp-4) var(--sp-3);
  }

  .toc-inline__item a {
    display: block;
    padding: 4px 0;
    color: var(--text-muted);
    line-height: 1.5;
    text-decoration: none;
    text-transform: lowercase;
  }

  .toc-inline__item--d3 a {
    padding-left: var(--sp-4);
    font-size: 0.9em;
  }

  .toc-inline__item a:hover {
    color: var(--text);
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]'));
  if (links.length) {
    const bySlug = new Map(links.map((a) => [a.dataset.toc, a]));
    const targets = links
      .map((a) => document.getElementById(a.dataset.toc!))
      .filter((el): el is HTMLElement => Boolean(el));

    let current: HTMLAnchorElement | null = null;
    const setActive = (slug: string | undefined) => {
      if (!slug) return;
      const next = bySlug.get(slug) ?? null;
      if (next === current) return;
      current?.classList.remove('is-active');
      next?.classList.add('is-active');
      current = next;
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

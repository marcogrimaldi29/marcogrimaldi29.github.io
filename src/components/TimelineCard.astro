---
/**
 * CvCard — experience/education entry. Org & institution logos appear as small
 * tile chips in the card's top-right. The primary logo is matched from the org
 * name; secondary logos cover Erasmus exchanges mentioned in meta/points (e.g. a
 * degree at Tor Vergata with an exchange at Mainz). All matching is on proper
 * nouns stable across locales (Mainz also localizes to Magonza/Maguncia).
 */
import { resolveLogos } from '@data/orgLogos';

interface Props {
  role: string;
  org: string;
  meta?: string[];
  points: string[];
  variant?: 'work' | 'edu';
}
const { role, org, meta = [], points, variant = 'work' } = Astro.props;

// Company / institution logos (Wikimedia Commons, credited in LogoDisclaimer) —
// resolved via the shared matcher so CareerMap reuses the same list. Entries with
// no match (Carlos V, Studiamo Insieme, I.T.I. Lattanzio…) show an empty tile.
const logos = resolveLogos(org, [org, ...meta, ...points].join(' '));
---

<article class:list={['cvcard', variant === 'edu' && 'cvcard--edu']}>
  <div class="cvcard__head">
    <h3 class="cvcard__role">{role}</h3>
    <div class="cvcard__meta">
      <span class="cvcard__org">{org}</span>
      {
        /* meta is [location, time-period]; the location pill is greened to
          set it apart from the gray time pill. */
      }
      {meta.map((m, i) => <span class:list={['badge', i === 0 && 'cvcard__loc']}>{m}</span>)}
    </div>
    <div class="cvcard__logos">
      {
        logos.length > 0 ? (
          logos.map((src) => (
            <img
              class:list={['cvcard__logo', src.includes('site-mark') && 'cvcard__logo--mark']}
              src={src}
              alt=""
              aria-hidden="true"
              loading="lazy"
            />
          ))
        ) : (
          <span class="cvcard__logo cvcard__logo--empty" aria-hidden="true" />
        )
      }
    </div>
  </div>
  <ul>
    {points.map((p) => <li>{p}</li>)}
  </ul>
</article>

<style>
  .cvcard {
    border: 1px solid var(--border);
    border-left: 3px solid var(--brand);
    border-radius: var(--radius);
    padding: var(--sp-4) var(--sp-5);
    background: var(--surface);
    margin-block: var(--sp-3);
    transition:
      border-color var(--transition),
      transform var(--transition);
  }

  /* Hover brightens each card's OWN semantic colour (work = azure, education =
     green) — never the cyan that now denotes notices — so the meaning stays clear. */
  .cvcard:hover {
    transform: translateX(3px);
    border-left-color: var(--brand-strong);
  }

  .cvcard--edu {
    border-left-color: var(--success);
  }

  .cvcard--edu:hover {
    border-left-color: color-mix(in srgb, var(--success) 65%, #fff);
  }

  /* Grid head: title + pills on the left, logo tiles on the right. On phones
     the pills drop below the logos and take the full card width, so long
     institution names stay on one line instead of squeezing beside the tiles. */
  .cvcard__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'role logos'
      'meta logos';
    align-items: start;
    column-gap: var(--sp-4);
    row-gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }

  /* Logo tile chips — light background keeps every logo readable; slightly
     dimmed at rest, brightening on hover for a dynamic touch. */
  .cvcard__logos {
    grid-area: logos;
    display: flex;
    flex-shrink: 0;
    gap: var(--sp-2);
  }

  .cvcard__logo {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: #f4f6f8;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 6px;
    box-shadow: var(--shadow);
    opacity: 0.88;
    transition:
      opacity var(--transition),
      transform var(--transition);
  }

  /* The personal placeholder mark is square, so it fills the tile; pad it down
     to match the smaller, letterboxed institution logos. */
  .cvcard__logo--mark {
    padding: 13px;
  }

  .cvcard:hover .cvcard__logo {
    opacity: 1;
    transform: scale(1.06);
  }

  .cvcard__role {
    grid-area: role;
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .cvcard__meta {
    grid-area: meta;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
  }

  /* Institution pill — sized like the sibling .badge pills (same font size,
     padding and line box) so the row reads as one set. Very long names may
     still wrap on the narrowest phones; balance keeps the two lines even. */
  .cvcard__org {
    display: inline-flex;
    align-items: center;
    max-width: 100%;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    line-height: 1.4;
    text-wrap: balance;
    background: var(--tag-cert-bg);
    color: var(--tag-cert-fg);
    border: 1px solid var(--tag-cert-ring);
    padding: 2px 8px;
    border-radius: var(--radius-pill);
  }

  .cvcard__meta .badge {
    line-height: 1.4;
  }

  /* Location pill — green (guide ramp) to read apart from the gray time pill. */
  .cvcard__loc {
    background: var(--tag-guide-bg);
    color: var(--tag-guide-fg);
    border-color: var(--tag-guide-ring);
  }

  .cvcard ul {
    margin: 0;
    padding-left: 1.2rem;
  }

  .cvcard li {
    font-size: var(--fs-sm);
    margin-bottom: var(--sp-1);
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (width <= 34rem) {
    .cvcard {
      padding: var(--sp-4);
    }

    .cvcard__head {
      grid-template-areas:
        'role logos'
        'meta meta';
      align-items: center;
      column-gap: var(--sp-3);
    }

    .cvcard__logo {
      width: 38px;
      height: 38px;
      padding: 5px;
    }

    .cvcard__logo--mark {
      padding: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cvcard:hover .cvcard__logo {
      transform: none;
    }
  }
</style>

---
/**
 * CertGroup — bounded section panel with an optional header bar (icon + title
 * + count badge) and a slotted body. Replaces the hand-copied cert-group HTML
 * (audit CQ-1).
 */
interface Props {
  icon?: string;
  title?: string;
  count?: number | string;
  titleAs?: 'span' | 'h2' | 'h3';
}
const { icon, title, count, titleAs = 'span' } = Astro.props;
const hasHeader = Boolean(title);
const TitleTag = titleAs;
---

<section class="panel">
  {
    hasHeader && (
      <div class="panel__header">
        {icon && (
          <span class="panel__icon" aria-hidden="true">
            {icon}
          </span>
        )}
        <TitleTag class="panel__title">{title}</TitleTag>
        {count !== undefined && <span class="badge badge--cert">{count}</span>}
      </div>
    )
  }
  <div class="panel__body">
    <slot />
  </div>
</section>

<style>
  .panel {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    margin-block: var(--sp-4);
  }

  .panel__header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-5);
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
  }

  .panel__icon {
    font-size: 1.1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .panel__title {
    font-size: 0.95rem;
    font-weight: 600;
    flex: 1;
    margin: 0;
    line-height: 1.3;
  }

  .panel__body {
    padding: var(--sp-4) var(--sp-5);
  }

  .panel__body :global(p) {
    margin: 0 0 var(--sp-3);
  }

  .panel__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .panel__body :global(ul) {
    margin: 0 0 var(--sp-3);
    padding-left: 1.2rem;
  }

  .panel__body :global(li) {
    margin-bottom: var(--sp-1);
    line-height: 1.6;
  }
</style>

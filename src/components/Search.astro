---
/**
 * Pagefind search UI (replaces lunr, audit PF-4), themed to the site identity.
 *
 * The index + UI assets live at /pagefind/. They are generated by Pagefind from
 * the BUILT output, so:
 *   - production / `astro preview`: created by the `postbuild` step (dist/pagefind).
 *   - `astro dev`: run `npm run search:index` once to populate public/pagefind,
 *     which the dev server then serves.
 */
import { getLocaleFromUrl, useTranslations } from '@i18n/utils';

const t = useTranslations(getLocaleFromUrl(Astro.url));
const onload = `new PagefindUI({ element: '#search', showSubResults: true, showImages: false, translations: { placeholder: ${JSON.stringify(t('search.placeholder'))} } });`;
---

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<div id="search" class="search"></div>
<script is:inline src="/pagefind/pagefind-ui.js" onload={onload}></script>

<style is:global>
  /* Pagefind UI variables → site tokens. */
  #search {
    --pagefind-ui-scale: 0.9;
    --pagefind-ui-primary: var(--brand-strong);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--surface-3);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-font: var(--font-sans);
  }

  /* Search input — match the dark theme with a brand focus ring. */
  #search .pagefind-ui__search-input {
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--text);
    font-weight: 400;
  }

  #search .pagefind-ui__search-input::placeholder {
    color: var(--text-subtle);
  }

  #search .pagefind-ui__search-input:focus {
    border-color: var(--brand);
    outline: none;
    box-shadow: 0 0 0 3px rgb(68 147 248 / 25%);
  }

  #search .pagefind-ui__search-clear {
    background: transparent;
    color: var(--text-muted);
  }

  #search .pagefind-ui__search-clear:hover {
    color: var(--text);
  }

  /* Result count / messages → mono meta. */
  #search .pagefind-ui__message {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--text-subtle);
  }

  /* Result cards — add vertical spacing between them. */
  #search .pagefind-ui__result {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--sp-3) var(--sp-4);
    margin-bottom: var(--sp-3);
    transition: border-color var(--transition);
  }

  #search .pagefind-ui__result:last-child {
    margin-bottom: 0;
  }

  #search .pagefind-ui__result:hover {
    border-color: var(--brand);
  }

  #search .pagefind-ui__result-title .pagefind-ui__result-link,
  #search .pagefind-ui__result-link {
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
  }

  #search .pagefind-ui__result-link:hover {
    color: var(--brand-strong);
    text-decoration: underline;
  }

  #search .pagefind-ui__result-excerpt {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: 1.6;
  }

  #search mark {
    background: var(--tag-cert-bg);
    color: var(--tag-cert-fg);
    border-radius: 3px;
    padding: 0 2px;
  }

  /* Sub-results (headings within a page). */
  #search .pagefind-ui__result-nested {
    border-left: 2px solid var(--border);
  }
</style>

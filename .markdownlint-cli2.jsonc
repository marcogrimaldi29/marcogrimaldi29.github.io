{
  // Lint only authored site content; docs/PLAN intentionally use long lines + inline HTML.
  "config": {
    "default": true,
    "MD013": false, // line length — prose wraps freely
    "MD033": false, // inline HTML — allowed in MDX content
    "MD041": false, // first line need not be a top-level heading (frontmatter precedes it)
  },
  "globs": ["src/content/**/*.{md,mdx}"],
  "ignores": ["node_modules", "dist", ".astro"],
}
